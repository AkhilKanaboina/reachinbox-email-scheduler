# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database (MySQL — local install) ─────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:root@localhost:3306/reachinbox"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# MUST be at least 32 characters. Generate with: openssl rand -hex 32
# MUST match NEXTAUTH_SECRET and JWT_SECRET in the frontend .env.local
JWT_SECRET="change-me-to-a-very-long-random-secret-at-least-32-chars"

# ─── Ethereal Email (fake SMTP) ───────────────────────────────────────────────
# Leave empty to auto-generate a new Ethereal account on startup.
# To reuse a specific account, set both values (check https://ethereal.email).
ETHEREAL_USER=
ETHEREAL_PASS=
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587

# ─── CORS / Frontend ──────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"

# ─── BullMQ Worker ────────────────────────────────────────────────────────────
# Number of concurrent email processing workers
WORKER_CONCURRENCY=5
