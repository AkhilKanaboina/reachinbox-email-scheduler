# ─── NextAuth.js ──────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"

# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET="change-me-to-a-very-long-random-secret-at-least-32-chars"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── Backend API ──────────────────────────────────────────────────────────────
# URL of the Express backend (NOT exposed to the browser — server-side only)
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ─── JWT (must match backend JWT_SECRET exactly) ──────────────────────────────
# Used server-side in NextAuth callbacks to mint tokens the backend can verify.
JWT_SECRET="change-me-to-a-very-long-random-secret-at-least-32-chars"
